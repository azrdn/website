---
const asciiArt = `
       .    *          .                .                              .             
   .                                .                      .     .         *         
       .         .          *                  .     *                  .            
 .    *                      .      .                  .                     .       
              #######                                          *                  .  
............###    #####.....................####................#####...............
:::::::::::##      ##$ ###::::::::::::::::###$#####::::::::::::##""$$####::::::::::::
~~~~~~~~~##         #$"" ###~~~~~~~~~~#####""$$##  ###--~~~~###   ""$"# ###~~~~~~~~~~
======###            $$""" ####===#####      "$$##   #######       $$" ##  ###=====##
===####              ##$$"""  #####             $$#   #####       $$ """###  ######  
###                   ##$$$"""   ###             $..       ###$$$$     "  ##      ###
  ###                  ###$$$      ####           #...                     ###       
                         ## $$        ##             ...                     #       
`;

const warningMsg = "warn: ASCII art line width is not consistent";
const lines = asciiArt.split("\n").filter(Boolean);
const width = lines[0]?.length ?? 0;

for (const line of lines) if (line.length !== width) console.warn(warningMsg);
---

<div id="marquee" aria-hidden="true">
  <pre>{asciiArt}</pre>
  <pre>{asciiArt}</pre>
  <pre>{asciiArt}</pre>
</div>

<style define:vars={{ width }}>
  @keyframes marquee {
    to {
      translate: -100% 0;
    }
  }

  #marquee {
    display: flex;
    color: light-dark(var(--light-fg), var(--dark-fg));
    font-size: 0.8rem;
    margin: 2rem 0;
    overflow: hidden;

    pre {
      margin: 0;
      font-family: inherit;
      line-height: 1;
      font-variant-ligatures: none;

      @media (prefers-reduced-motion: no-preference) {
        animation: marquee 20s steps(var(--width)) infinite;
      }
    }

    @media (max-width: 900px) {
      font-size: 1.8vw;
    }
  }
</style>
