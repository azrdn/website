---
import { actions as gstBook } from "astro:actions";
import GuestbookEntry from "@components/guestbook/entry.astro";

export const prerender = false;
interface Props {
	navHref: string;
	page: number;
}

const entriesPerPage = 10;
const { navHref, page } = Astro.props;
const { data, error } = await Astro.callAction(gstBook.getEntryCount, null);
if (error) throw new Error("Failed to fetch entry count");
const totalPages = Math.max(1, Math.ceil(data / entriesPerPage));

const res = await Astro.callAction(gstBook.getEntries, {
	offset: entriesPerPage * (page - 1),
	limit: entriesPerPage,
});
if (res.error) throw new Error("Failed to fetch guestbook data");
---

{
  res.data.length > 0 ? (
    <div id="entries">
      {res.data.map((entry) => <GuestbookEntry {...entry} />)}
    </div>
  ) : null /* TODO: add something */
}
<div class="pagination">
  {
    /* TODO: add something */
    <p>Viewing page {page} out of {totalPages}</p>
  }
  <div class="pagelinks">
    {
      page > 1 && (
        <a class="prev" href={`${navHref}?page=${page - 1}`}>Previous</a>
      )
    }
    {
      page < totalPages && (
        <a class="next" href={`${navHref}?page=${page + 1}`}>Next</a>
      )
    }
  </div>
</div>

<style>
#entries {
  display: flex;
  flex-direction: column;
  margin: 1lh 0;
  gap: 1em;
}

.pagelinks {
  display: flex;
  gap: 1em;
}

.prev::before {
  content: "← ";
}

.next::after {
  content: " →";
}

</style>
