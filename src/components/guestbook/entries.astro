---
import { actions as guestbook } from "astro:actions";
import GuestbookEntry from "@components/guestbook/entry.astro";
import { AstroError } from "astro/errors";

export const prerender = false;
interface Props {
	navHref: string;
	count: number;
	curPage: number;
}

const entriesPerPage = 10;
const { navHref, count, curPage } = Astro.props;

const res = await Astro.callAction(guestbook.getEntries, {
	offset: entriesPerPage * (curPage - 1),
	limit: entriesPerPage,
});
if (res.error) throw new AstroError("Failed to fetch guestbook data");

const totalPages = Math.max(1, Math.ceil(count / entriesPerPage));
---

{
  res.data.length > 0 && (
    <div id="entries">
      {res.data.map((entry) => <GuestbookEntry {...entry} />)}
    </div>
  )
}
<div class="pagination">
  <p>Viewing page {curPage} out of {totalPages}</p>
  <div class="pagelinks">
    {
      curPage > 1 && (
        <a href={`${navHref}?page=${curPage - 1}`}>Previous Page</a>
      )
    }
    {
      curPage < totalPages && (
        <a href={`${navHref}?page=${curPage + 1}`}>Next Page</a>
      )
    }
  </div>
</div>

<style>
#entries {
  display: flex;
  flex-direction: column;
  margin: 1lh 0;
  gap: 1em;
}

.pagination {
  margin: 1lh 0;
}

.pagelinks {
  display: flex;
  gap: 1em;
  justify-content: space-between;
}
</style>
