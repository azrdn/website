---
import Footer from "@components/main/footer.astro";
import Layout from "@components/main/layout.astro";
import Navbar from "@components/main/navbar.astro";
import { AstroError } from "astro/errors";

export const prerender = false;

interface Props {
	error: unknown;
}

const { error } = Astro.props;
if (!(error instanceof AstroError)) {
	if (process.env.NODE_ENV === "development") throw error;
	throw new Error("Internal server error");
}

const code = error.type === "AstroUserError" ? "400" : "500";
const message = error.message;
---

<Layout title="Error">
	<Navbar slot="header" label={code} />
	<h1>Error</h1>
	<div>{message}</div>
	<Footer slot="footer" />
</Layout>
