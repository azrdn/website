---
import { getCollection, render } from "astro:content";
import BskyComments from "@components/blog/bsky_comments.astro";
import CodeBtns from "@components/blog/codeblock_btns.astro";
import Toc from "@components/blog/toc.astro";
import Footer from "@components/main/footer.astro";
import Layout from "@components/main/layout.astro";
import Navbar from "@components/main/navbar.astro";
import type { GetStaticPaths } from "astro";

import "@styles/blog.css";
import { ISO } from "@utils/date";

export const getStaticPaths = (async () => {
	const testBlog = import.meta.env.DEV ? await getCollection("testBlog") : [];
	const blog = await getCollection("blog");
	const collection = [...testBlog, ...blog] as typeof blog;
	return collection.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, createdAt, updatedAt, bskyPostUri } = post.data;
const ogImageUrl = new URL("og.png", Astro.url);
---

<Layout {title} {ogImageUrl}>
  <Navbar slot="header" label="post" />
	<article>
		<header>
			<h1>{title}</h1>
			<p id="info">
				<span title={ISO(createdAt)}>
					Publ: <time>{ISO(createdAt, true)}</time>
				</span>
				{updatedAt &&
					<span title={ISO(updatedAt)}>
						Upd: <time>{ISO(updatedAt, true)}</time>
					</span>
				}
			</p>
			{
				headings.length > 0 && (
					<details id="toc">
						<summary>Table of Contents</summary>
						<Toc {headings} />
					</details>
				)
			}
		<hr />
		</header>
		<Content />
		{bskyPostUri && (
		  <hr>
      <details>
        <summary>Comments</summary>
        <BskyComments uri={bskyPostUri} />
      </details>
		)}
	</article>
	<CodeBtns />
	<Footer slot="footer" />
</Layout>

<style>
	#info {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 2ch;

		> * {
			border: 1px solid light-dark(var(--light-bg-secondary), var(--dark-bg-secondary));
			padding: 0.1em calc(1ch - 1px);
		}
	}

	@media (width >= 1600px) {
		#toc {
			position: fixed;
			padding: 0 1ch;
			top: 0;
			left: 0;
			margin: 1lh 2ch;
			max-height: 70svh;
			width: 35ch;

			&[open] {
				overflow-y: scroll;
			}
		}

		:global(body:has(#toc:hover) .topheader) {
			transform: none;
		}
	}
</style>
