---
import { actions as gstBook } from "astro:actions";
import GBEntries from "@components/guestbook/entries.astro";
import GBForm from "@components/guestbook/form.astro";
import Footer from "@components/main/footer.astro";
import Layout from "@components/main/layout.astro";
import Navbar from "@components/main/navbar.astro";
import { AstroError } from "astro/errors";
import z from "astro/zod";

export const prerender = false;

const param = Astro.url.searchParams.get("page") ?? "1";
const { data: page } = z.coerce.number().int().positive().safeParse(param);
if (!page) throw new AstroError("Invalid page query parameter");

const result = Astro.getActionResult(gstBook.postEntry);
if (result?.error) throw result.error;
if (result && !result.error) return Astro.redirect(`/guestbook/`);
---

<Layout>
  <Navbar slot="header" />
  {
    page === 1 && (
      <h1>Guestbook</h1>
      <GBForm url={gstBook.postEntry} />
      <hr>
    )
  }
  <GBEntries server:defer navHref="/guestbook/" {page} />
  <Footer slot="footer" />
</Layout>
